{
  "name": "@magic-resume-kit/resume-schema",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./dist/schema.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-schema.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "description": "Validated resume data contracts, template IDs and JSON Schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magic-Resume/magic-resume-kit.git",
    "directory": "packages/resume-schema"
  },
  "homepage": "https://github.com/Magic-Resume/magic-resume-kit/tree/main/packages/resume-schema",
  "bugs": {
    "url": "https://github.com/Magic-Resume/magic-resume-kit/issues"
  }
}
