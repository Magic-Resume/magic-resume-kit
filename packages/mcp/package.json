{
  "name": "@magic-resume-kit/mcp",
  "version": "1.0.0",
  "description": "Local MCP server and CLI for schema-aware access to the Magic Resume API.",
  "license": "MIT",
  "homepage": "https://github.com/Magic-Resume/magic-resume-kit/tree/main/packages/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magic-Resume/magic-resume-kit.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Magic-Resume/magic-resume-kit/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "resume",
    "cv",
    "resume-builder",
    "claude-code",
    "magic-resume"
  ],
  "mcpName": "io.github.Magic-Resume/magic-resume",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "magic-resume": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && node scripts/bundle.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-json-patch": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@magic-resume-kit/resume-schema": "workspace:*",
    "@magic-resume-kit/resume-templates": "workspace:*",
    "@types/node": "^20.19.41",
    "esbuild": "^0.28.0",
    "typescript": "^5"
  }
}
